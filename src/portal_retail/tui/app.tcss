/* Portal Retail v2 — Estilos globales Textual */

/* ─── Variables de color ──────────────────────────────────────────────────── */
/* accent: #70AD47 (verde Skandia) */
/* dark-bg: #1a1a2e */

/* ─── App base ────────────────────────────────────────────────────────────── */
App {
    background: #1a1a2e;
}

Screen {
    height: 100%;
}

/* ─── Header / Footer ────────────────────────────────────────────────────── */
Header {
    background: #70AD47;
    color: white;
    text-style: bold;
}

Footer {
    background: #16213e;
    color: #70AD47;
}

/* ─── Inputs ─────────────────────────────────────────────────────────────── */
Input {
    border: solid #70AD47;
    background: #16213e;
    color: white;
    margin-bottom: 1;
}

Input:focus {
    border: solid white;
    background: #0f3460;
}

/* ─── Select ─────────────────────────────────────────────────────────────── */
Select {
    border: solid #70AD47;
    background: #16213e;
    color: white;
    margin-bottom: 1;
}

Select:focus {
    border: solid white;
}

SelectOverlay {
    background: #16213e;
    border: solid #70AD47;
}

/* ─── Botones ────────────────────────────────────────────────────────────── */
Button {
    border: solid #70AD47;
    color: white;
    padding: 0 2;
}

Button:hover {
    background: #70AD47;
    color: white;
    text-style: bold;
}

Button:focus {
    border: solid white;
    text-style: bold;
}

Button.-success {
    background: #70AD47;
    color: white;
    border: solid #5a9035;
}

Button.-success:hover {
    background: #5a9035;
}

Button.-primary {
    background: #4472C4;
    color: white;
    border: solid #3560a8;
}

Button.-primary:hover {
    background: #3560a8;
}

Button.-default {
    background: #16213e;
    color: #a0a0a0;
    border: solid #404060;
}

Button.-default:hover {
    background: #0f3460;
    color: white;
}

/* ─── Checkbox ───────────────────────────────────────────────────────────── */
Checkbox {
    color: white;
    background: transparent;
}

Checkbox:focus {
    color: #70AD47;
}

/* ─── Labels ────────────────────────────────────────────────────────────── */
Label {
    color: white;
}

/* ─── ScrollableContainer ───────────────────────────────────────────────── */
ScrollableContainer {
    background: #1a1a2e;
    scrollbar-background: #16213e;
    scrollbar-color: #70AD47;
    scrollbar-color-hover: white;
}

/* ─── Containers generales ──────────────────────────────────────────────── */
Container {
    background: #1a1a2e;
}

Vertical {
    background: #1a1a2e;
}
